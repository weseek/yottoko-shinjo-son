# App
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/arcana"

# PostgreSQL (docker-compose で使用)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arcana

# Email
# 開発環境では実際のメール送信を行わない（tmp/emails に保存されるのみ）ため、
# 通知先 NOTIFICATION_RECIPIENTS は設定不要。production でのみ SecretManager から注入する。

# AR モデル (GLB)
# キャラクターモデルはリポジトリに同梱していない（第三者に権利があるため）。
# public/assets/ に .glb を置いてそのパスを指定する。詳細は README の「AR モデルの配置」を参照。
# AR_MODEL_URL="/assets/your-model.glb"

# Object Storage
# 開発環境 (APP_ENV=development) ではローカル (public/uploads) に保存するため未設定で OK。
# GCS を使う場合のみ設定:
# GCS_BUCKET="your-gcs-bucket-dev"
#
# 注意: 未設定だと next.config.ts の images.remotePatterns が GCS を一切許可しない
# (fail-closed) ため、GCS の絶対 URL を含む DB（本番ダンプ等）を使うと <Image> の
# 画像表示がエラーになる。その場合は対象バケット名をここで設定する（公開読み取り
# バケットなら認証は不要）。
