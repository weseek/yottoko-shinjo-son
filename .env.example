# App
APP_ENV="development"              # development | production
NEXT_PUBLIC_APP_ENV="development"  # APP_ENV と同じ値を設定

# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/arcana"

# PostgreSQL (docker-compose で使用)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arcana

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="your-app <noreply@example.com>"
# 申込・キャンセル通知メールの送信先。カンマ区切りで複数指定可。
# production では必須で SecretManager から注入する。それ以外の環境は実際に送信しない
# ため未設定でよい（設定しても害はない）。
# NOTIFICATION_RECIPIENTS="admin@example.com"

# Google Maps (スポット一覧ページの地図ピン表示)
# - GOOGLE_MAPS_BROWSER_KEY: 地図描画用 (Maps JavaScript API)。ブラウザに露出する公開キー。
#   GCP で HTTP リファラー制限 (本番ドメイン) を必ず設定すること。
# - GOOGLE_GEOCODING_API_KEY: 住所→緯度経度の変換用 (Geocoding API)。サーバ専用・秘匿。
# どちらも未設定なら地図・自動ジオコーディングは無効（住所はテキスト表示のまま）。
GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_GEOCODING_API_KEY=""

# Umami アクセス解析 (Cookieless・自前ホスト)
# 両方設定したときだけ計測タグを出力する（＝本番のみ設定し、ローカルでは空のまま）。
# 値は公開情報。サブドメイン化したら UMAMI_SCRIPT_URL を差し替えるだけ。
UMAMI_SCRIPT_URL=""
UMAMI_WEBSITE_ID=""

# AR モデル (GLB)
# 既定で表示する 3D モデルの配置先。相対パス（public/ 配下に置いた場合）でも
# 絶対 URL（GCS 等に置いた場合）でもよい。
# キャラクターモデルは第三者に権利があるためリポジトリには同梱していない。
# 詳細は README の「AR モデルの配置」を参照。未設定でもアプリは動作し、AR 撮影のみ無効になる。
AR_MODEL_URL="/assets/your-model.glb"

# Object Storage (Google Cloud Storage)
# バケットは公開読み取り設定（allUsers:objectViewer）必須
GCS_BUCKET="your-gcs-bucket"

# 認証 (ローカル開発時のみ): サービスアカウントキー JSON のパス
# Cloud Run 上では未設定で OK（Workload Identity / Compute SA が ADC として自動採用される）
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/gcs-dev-key.json"

# Better Auth (管理パネル認証)
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3005

# 連絡先メールアドレス (フッター・プライバシーポリシー・利用規約等に表示)
CONTACT_EMAIL="contact@example.com"

# 初期管理者アカウント (prisma db seed で使用)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_NAME=Admin
